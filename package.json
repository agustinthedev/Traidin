{
  "name": "treidin-market-data",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "dev:api": "tsx watch server/index.ts",
    "start:api": "tsx server/index.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:backup": "tsx server/db/maintenance-cli.ts backup",
    "db:optimize": "tsx server/db/maintenance-cli.ts optimize",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "perf:sqlite": "tsx scripts/sqlite-performance.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@types/pdfkit": "^0.17.6",
    "better-sqlite3": "^13.0.2",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.0",
    "lightweight-charts": "^5.2.0",
    "next": "^16.2.12",
    "pdfkit": "^0.19.1",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
