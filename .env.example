DATABASE_URL=sqlite:///./data/trading-platform.db
SQLITE_BACKUP_DIR=./data/backups
SQLITE_BATCH_SIZE=5000
API_HOST=127.0.0.1
API_PORT=4100
NEXT_PUBLIC_API_URL=http://localhost:4100
BINANCE_REST_URL=https://fapi.binance.com
BINANCE_WS_URL=wss://fstream.binance.com/market/stream
BINANCE_API_KEY=
BINANCE_API_SECRET=
ENABLED_SYMBOLS=BTCUSDT,ETHUSDT
AGGREGATED_TIMEFRAMES=5m,15m,1h,4h,1d,1w
LOG_LEVEL=info
EVENT_RETENTION_DAYS=30
# Automatic full data-quality scan cadence (5 minutes by default).
DATA_QUALITY_SCAN_INTERVAL_MS=300000
# Gap repairs are only marked stalled after this period without a checkpoint.
GAP_REPAIR_STALL_TIMEOUT_MS=600000
